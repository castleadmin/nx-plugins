{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "target": "es2022",
    "lib": ["ES2022"],
    "types": ["jest", "node"],
    "sourceMap": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true
  },
  "include": ["jest.config.ts", "src/**/*.ts"]
}
